# Runtime/serverless queries use the pooled endpoint (falls back to DATABASE_URL locally).
DATABASE_URL="postgresql://ihue:ihue@localhost:5432/ihue"

# Prisma migrations use a direct endpoint to avoid transaction-pooler limitations.
DIRECT_URL="postgresql://ihue:ihue@localhost:5432/ihue"

# At least 32 random characters; used to protect OTP challenges, sessions, and the Google OAuth flow cookie.
# Generate a fresh value for this app — do not reuse ihueRating's AUTH_SECRET.
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Use "mock" locally or "ses" for real email delivery.
# Reserved *.test identities always use the on-screen mock in non-production environments.
EMAIL_PROVIDER="mock"

# Required when EMAIL_PROVIDER="ses". This app intentionally reuses ihueRating's/atride's SES
# identity in the same AWS account (same AWS_ACCESS_KEY_ID/SECRET as ihueRating's .env.local),
# with a distinct SES_FROM_EMAIL so recipients and bounce/complaint handling stay separable.
AWS_REGION="ap-south-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional when temporary AWS credentials are used.
AWS_SESSION_TOKEN=""
SES_FROM_EMAIL="noreply@bid.ihue.in"
SES_FROM_NAME="ihue Bid"
# Optional and visible to message recipients; omit for no-reply OTP email.
SES_REPLY_TO_EMAIL=""
# Optional until SES event publishing is configured.
SES_CONFIGURATION_SET=""

# Google OpenID Connect. APP_URL must exactly match a registered callback origin.
# Use a separate Google Cloud project/credentials from ihueRating/@Ride so billing, quotas, and
# revocation stay independent. Sign-in with email OTP works without these being set.
APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Protects internal/cron-triggered worker endpoints (e.g. the outbox dispatcher).
CRON_SECRET="replace-with-a-long-random-secret"

# Cloudinary signed uploads. API secret is server-only.
# This app intentionally reuses ihueRating's Cloudinary account (same CLOUDINARY_CLOUD_NAME/
# API_KEY/API_SECRET) under a distinct folder prefix, so no new Cloudinary account is needed.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER_PREFIX="ihue-bid/development"
